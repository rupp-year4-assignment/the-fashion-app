                  "const data = pm.response.json();",
                  "if (data?.data?.productId) pm.collectionVariables.set('productId', data.data.productId);",
                  "if (data?.data?._id) pm.collectionVariables.set('mongoProductId', data.data._id);",
                  "if (data?.data?.variants?.[0]?.variantId) pm.collectionVariables.set('variantId', data.data.variants[0].variantId);"
                ]
