        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data?.data?.access_token) pm.collectionVariables.set('accessToken', data.data.access_token);",
                  "if (data?.data?.refresh_token) pm.collectionVariables.set('refreshToken', data.data.refresh_token);",
                  "pm.test('Login returns 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{email}}\",\"password\":\"password123\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}{{apiPrefix}}/auth/login"
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data?.data?.access_token) pm.collectionVariables.set('accessToken', data.data.access_token);",
                  "if (data?.data?.refresh_token) pm.collectionVariables.set('refreshToken', data.data.refresh_token);",
                  "pm.test('Refresh returns 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-refresh-token",
                "value": "{{refreshToken}}"
              }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/auth/refresh"
